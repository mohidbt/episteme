{
  "name": "@episteme/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "drizzle-kit migrate",
    "generate": "drizzle-kit generate",
    "studio": "drizzle-kit studio",
    "predeploy-check": "tsx scripts/predeploy-check.ts",
    "db:record-applied": "tsx scripts/record-applied.ts",
    "db:lint-drift": "tsx scripts/lint-schema-drift.ts",
    "db:snapshot-dump": "tsx scripts/snapshot-dump.ts",
    "db:snapshot-diff": "tsx scripts/snapshot-diff.ts",
    "db:snapshot-update": "tsx scripts/snapshot-dump.ts packages/db/schema-snapshot.sql",
    "db:backfill-papers-size": "tsx scripts/backfill_papers_size_bytes.ts",
    "db:audit-papers-size": "tsx scripts/audit_papers_size_bytes.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "dotenv": "^16.4.5",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^4.1.4"
  }
}
