{
  "name": "episteme",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev:km": "pnpm -F km dev",
    "dev:reader": "pnpm -F reader dev",
    "dev:agents": "cd services/agents && uv run fastapi dev",
    "build": "pnpm -r --parallel build",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "pnpm -r --parallel lint",
    "db:migrate": "pnpm -F @episteme/db migrate",
    "db:generate": "pnpm -F @episteme/db generate",
    "db:studio": "pnpm -F @episteme/db studio",
    "db:predeploy-check": "pnpm -F @episteme/db predeploy-check",
    "check:scalability": "tsx scripts/check-skill-addition.ts",
    "test:scripts": "tsx --test scripts/check-skill-addition.test.ts scripts/post-deploy-smoke.test.ts",
    "smoke:auth-hooks": "tsx scripts/smoke-auth-hooks.ts",
    "smoke:post-deploy": "tsx scripts/post-deploy-smoke.ts",
    "security:audit": "pnpm audit --prod --audit-level high"
  },
  "devDependencies": {
    "tsx": "^4.21.0"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-fx2h-pf6j-xcff"
      ]
    },
    "onlyBuiltDependencies": [
      "@sentry-internal/node-cpu-profiler",
      "@sentry/cli",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "brace-expansion@5": ">=5.0.6 <6",
      "dompurify": ">=3.4.11",
      "fast-xml-builder": ">=1.1.7",
      "fast-xml-parser": ">=5.7.0 <6",
      "fast-uri": ">=3.1.2",
      "hono": ">=4.12.25",
      "ip-address": ">=10.1.1 <11",
      "js-yaml@3": ">=3.15.0 <4",
      "js-yaml@4": ">=4.2.0 <5",
      "linkify-it": ">=5.0.1 <6",
      "markdown-it": ">=14.2.0 <15",
      "mermaid": ">=11.15.0 <12",
      "postcss": ">=8.5.10 <9",
      "qs": ">=6.15.2 <7",
      "uuid@11": ">=11.1.1 <12",
      "ws": ">=8.21.0 <9"
    }
  }
}
