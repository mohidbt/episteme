{
  "name": "episteme",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev:km": "pnpm -F km dev",
    "dev:reader": "pnpm -F reader dev",
    "dev:agents": "cd services/agents && uv run fastapi dev",
    "build": "pnpm -r --parallel build",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "pnpm -r --parallel lint",
    "db:migrate": "pnpm -F @episteme/db migrate",
    "db:generate": "pnpm -F @episteme/db generate",
    "db:studio": "pnpm -F @episteme/db studio",
    "db:predeploy-check": "pnpm -F @episteme/db predeploy-check",
    "check:scalability": "tsx scripts/check-skill-addition.ts",
    "test:scripts": "tsx --test scripts/check-skill-addition.test.ts"
  },
  "devDependencies": {
    "tsx": "^4.21.0"
  },
  "engines": {
    "node": ">=20"
  }
}
