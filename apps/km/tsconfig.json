{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"],
      "@episteme/db": ["../../packages/db/src/index.ts"],
      "@episteme/db/*": ["../../packages/db/src/*"],
      "@episteme/auth": ["../../packages/auth/src/index.ts"],
      "@episteme/auth/*": ["../../packages/auth/src/*"],
      "@episteme/editor": ["../../packages/editor/src/index.ts"],
      "@episteme/markdown": ["../../packages/markdown/src/index.ts"]
    }
  },
  "include": ["next-env.d.ts", "src/**/*.ts", "src/**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", "src/lib/agent/_deferred/**"]
}
