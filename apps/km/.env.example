# apps/km — environment variables
#
# Local development uses sensible defaults (see src/lib/storage.ts and the
# AGENTS_URL fallback in api/papersets/[id]/enrich). Deploy targets
# (Vercel preview/production) MUST set every variable below — empty values
# fall back to localhost endpoints that don't exist outside the dev box and
# silently break papers covers (C2/C4) and paperset enrichment (C6).

# --- Auth ---
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --- Database (Postgres / Neon) ---
DATABASE_URL=postgresql://episteme:episteme@localhost:5433/episteme

# --- Object storage (S3 / MinIO) ---
# Used by paper covers, paper sources, and assets. Currently the only
# storage backend (no Vercel Blob path). If any of these are blank in a
# deploy, /api/papers/:id/cover redirects to a presigned URL on
# http://localhost:9000 which the browser cannot reach.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=episteme-dev
S3_ACCESS_KEY=episteme
S3_SECRET_KEY=episteme-dev
S3_REGION=us-east-1
# Production endpoints must use HTTPS. Set this only when MinIO is reached over
# a trusted private network that intentionally terminates TLS elsewhere.
S3_ALLOW_INSECURE_HTTP=false

# --- Agents service (services/agents) ---
# Base URL of the FastAPI agents service. Empty means "no agents", which
# turns paperset enrichment, citations extract, AI chat, etc. into 502s.
AGENTS_URL=http://localhost:8001

# Shared HMAC secret signed into outbound /agents/km/* requests. Must
# match services/agents' INHALE_INTERNAL_SECRET.
INHALE_INTERNAL_SECRET=

# --- Encryption (BYOK) ---
ENCRYPTION_KEY=

# --- Optional ---
EPISTEME_PUBLISH_DOMAIN=
EPISTEME_SHARED_LLM_KEY=

# --- OpenRouter Provisioning (GSD-126 P0) ---
# Org-level provisioning key from https://openrouter.ai/settings/provisioning-keys.
# Used ONLY to mint + read per-user $5 trial buckets via /api/v1/keys; NEVER
# used as a completions Authorization header. Without this var set, signed-in
# users fall through to OPENROUTER_API_KEY (rollout safety net).
OPENROUTER_PROVISIONING_KEY=

# --- Transactional email / Resend (GSD-142) ---
# Resend API key. REQUIRED in production: signup email-verification is a HARD
# gate, so if this is unset the verification email silently no-ops and new users
# are trapped. Set in BOTH Vercel `production` AND `preview` scopes. The sending
# domain (see ALERT_EMAIL_FROM) MUST be verified in the Resend dashboard (SPF +
# DKIM) or Resend accepts the call but drops delivery. Boot logs a loud error if
# this is missing in production (instrumentation.ts / assert-email-config.ts).
RESEND_API_KEY=
# From-address for verification + key-health alert emails. Must be on a Resend-
# verified domain. Defaults to alerts@tryepisteme.com when unset.
ALERT_EMAIL_FROM=
